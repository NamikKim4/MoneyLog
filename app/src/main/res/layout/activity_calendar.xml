<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="24dp"
    android:paddingRight="20dp"
    android:paddingBottom="8dp">

    <!-- 조용한 상단 바: 이전/다음 달 화살표 + 가운데 월 라벨 + 메모 목록 아이콘 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btnPrevMonth"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_circle_ghost"
            android:clickable="true"
            android:contentDescription="@string/calendar_prev_month"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="‹"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvMonthYear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_main"
            android:textSize="17sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/btnNextMonth"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_circle_ghost"
            android:clickable="true"
            android:contentDescription="@string/calendar_next_month"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="›"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnMemoList"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_circle_ghost"
            android:clickable="true"
            android:contentDescription="@string/memo_list_button"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="📝"
                android:textSize="14sp" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView style="@style/WeekdayHeaderText" android:text="@string/weekday_sun" android:textColor="@color/danger" />
        <TextView style="@style/WeekdayHeaderText" android:text="@string/weekday_mon" />
        <TextView style="@style/WeekdayHeaderText" android:text="@string/weekday_tue" />
        <TextView style="@style/WeekdayHeaderText" android:text="@string/weekday_wed" />
        <TextView style="@style/WeekdayHeaderText" android:text="@string/weekday_thu" />
        <TextView style="@style/WeekdayHeaderText" android:text="@string/weekday_fri" />
        <TextView style="@style/WeekdayHeaderText" android:text="@string/weekday_sat" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/calendarGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/divider" />

    <!-- 선택한 날짜 요약: 지출 목록 화면의 날짜 헤더와 같은 방식(라벨 + 옅은 금액)으로,
         아래 "이번 달 총 지출" 카드와 헷갈리지 않도록 배경 없는 플랫 텍스트로만 보여준다. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSelectedDateLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSelectedDayTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:textColor="@color/text_sub"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/btnAddForDay"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_circle_primary"
            android:clickable="true"
            android:contentDescription="@string/add_expense_title"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </FrameLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvSelectedDayEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/selected_day_empty_message"
        android:textColor="@color/text_sub"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSelectedDayExpenses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <!-- 이번 달 총 지출: 화면에서 유일하게 남는 "총 지출" 표시. 필터 없이 채운 배너 대신
         차분한 카드 스타일로 바꿔서 위의 날짜별 합계와 시각적으로 절대 헷갈리지 않게 한다. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_rounded_card"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calendar_month_total_label"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvMonthTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 이 달의 예산 대비 남은/초과 금액. 예산은 달마다 따로 설정되므로,
             달을 넘길 때마다 그 달에 맞는 값으로 다시 계산해서 보여준다. -->
        <TextView
            android:id="@+id/tvCalendarBudgetStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
