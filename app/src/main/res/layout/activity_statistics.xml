<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="24dp"
        android:paddingRight="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/statistics_title"
            android:textColor="@color/primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 조용한 상단 바: 이전/다음 달 화살표 + 가운데 월 라벨 (캘린더 화면과 같은 스타일) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnStatsPrevMonth"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_ghost"
                android:clickable="true"
                android:contentDescription="@string/calendar_prev_month"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="‹"
                    android:textColor="@color/text_main"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvStatsMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/btnStatsNextMonth"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_ghost"
                android:clickable="true"
                android:contentDescription="@string/calendar_next_month"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="›"
                    android:textColor="@color/text_main"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </FrameLayout>

        </LinearLayout>

        <!-- 카드 1: 최근 6개월 추이 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_soft"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/monthly_trend_title"
                android:textColor="@color/text_sub"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <com.moneylog.app.ui.MonthlyBarChartView
                android:id="@+id/trendChart"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- 카드 2: 카테고리별 비중(도넛 + 목록) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_soft"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_breakdown_title"
                android:textColor="@color/text_sub"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center">

                <com.moneylog.app.ui.CategoryDonutChartView
                    android:id="@+id/donutChart"
                    android:layout_width="168dp"
                    android:layout_height="168dp" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/categoryLegendContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvStatsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/statistics_empty_message"
                android:textColor="@color/text_sub"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
